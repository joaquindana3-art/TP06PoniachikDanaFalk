@{
    List<PalabrasRosco> palabrasRosco = ViewBag.palabrasRosco;
    int i = ViewBag.i;
    int palabrasCorrectas = ViewBag.palabrasCorrectas;
    int palabrasIncorrectas = ViewBag.palabrasIncorrectas;
    string resultado = ViewBag.resultado;
}

<div>
Palabras correctas: <p id="cantPalabrasCorrectas">@palabrasCorrectas</p>
</div>
<div>
Palabras incorrectas: <p id="cantPalabrasIncorrectas">@palabrasIncorrectas</p>
</div>

@if (!string.IsNullOrEmpty(resultado))
{
    <div id="resultado">@resultado</div>
}
@if (i >= palabrasRosco.Count && palabrasCorrectas >= palabrasIncorrectas)
{
    <p>Completaste el rosco.</p>
    <a href="/Home/TerceraHabitacion">Siguiente habitación</a>
}
else if (i >= palabrasRosco.Count && palabrasCorrectas < palabrasIncorrectas)
{
    <p>Perdiste el rosco.</p>
    <a href="/Home/SegundaHabitacion">Reintentar</a>
}
else
{
    <p id="letra">@palabrasRosco[i].letra</p>
    <p id="pista">@palabrasRosco[i].pista</p>

    <form asp-action="SegundaHabitacion" method="post">
        <input type="text" id="respuesta" name="respuesta" required />
        <input type="hidden" name="i" value="@i" />
        <input type="hidden" name="palabrasCorrectas" value="@palabrasCorrectas" />
        <input type="hidden" name="palabrasIncorrectas" value="@palabrasIncorrectas" />
        <button type="submit">Arriesgar palabra</button>
    </form>
}
<a class="escondido" href="/Home/TerceraHabitacion">Siguiente habitación</a>